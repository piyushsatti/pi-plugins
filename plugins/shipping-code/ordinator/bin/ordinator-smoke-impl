#!/usr/bin/env bash
# ordinator-smoke-impl <fleet-dir> <orc> <base-ref>
# Creates a throwaway worktree named smoke-<n> from <base-ref> and launches ordinator-launch-impl --smoke in it,
# to exercise the child environment contract (registry reach, sources, access boundary) without spending
# a fleet slot. Prints the worktree path and the attach line. Does not clean up: prints the two commands
# the orchestrator runs, on the user's word, to archive the worktree and kill the tmux session.
set -euo pipefail

FLEET_DIR=$1; ORC=$2; BASE=$3
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Walks up from a starting directory looking for .ordinator/PROJECT.md, the way git looks for .git.
find_root() {
  local d="$1"
  while [ "$d" != "/" ]; do
    [ -f "$d/.ordinator/PROJECT.md" ] && { printf '%s\n' "$d"; return 0; }
    d=$(dirname "$d")
  done
  echo "no .ordinator/PROJECT.md found walking up from $1; run /ordinator:setup" >&2
  exit 2
}
ROOT=$(find_root "$FLEET_DIR")

WORKTREE_ROOT=$(awk '
  /^```ordinator-project$/ { infence=1; next }
  /^```$/ { if (infence) infence=0; next }
  infence {
    line=$0
    sub(/#.*/, "", line)
    gsub(/^[ \t]+|[ \t]+$/, "", line)
    if (line == "") next
    split(line, kv, /:[ \t]*/)
    if (kv[1] == "worktree_root") {
      val=line
      sub(/^[^:]+:[ \t]*/, "", val)
      print val
      exit
    }
  }
' "$ROOT/.ordinator/PROJECT.md")
[ -n "$WORKTREE_ROOT" ] || { echo "$ROOT/.ordinator/PROJECT.md: worktree_root is blank or the project is not configured; run /ordinator:setup" >&2; exit 2; }

source "$HERE/ordinator-find-clone"
CLONE=$(find_clone "$ROOT")

WT_SCRIPT=$(ls -d ~/.claude/plugins/cache/*/worktree/*/scripts/worktree.sh 2>/dev/null | xargs -r ls -t 2>/dev/null | head -1)
[ -n "$WT_SCRIPT" ] || { echo "worktree plugin script not found under ~/.claude/plugins/cache" >&2; exit 2; }

N=1
while [ -d "$ROOT/$WORKTREE_ROOT/smoke-$N" ]; do N=$((N + 1)); done
SLUG="smoke-$N"

(cd "$CLONE" && bash "$WT_SCRIPT" add "$SLUG" --base "$BASE")

WT="$ROOT/$WORKTREE_ROOT/$SLUG"
[ -d "$WT" ] || { echo "worktree not created: $WT" >&2; exit 2; }

LAUNCH_OUT=$(bash "$HERE/ordinator-launch-impl" "$FLEET_DIR" "$ORC" "$SLUG" "$WT" "$SLUG" "$BASE" --smoke)
printf '%s\n' "$LAUNCH_OUT"
TMUX_NAME=$(printf '%s\n' "$LAUNCH_OUT" | sed -n 's/^attach with: tmux attach -t //p' | tail -1)

echo "worktree: $WT"
if [ -n "$TMUX_NAME" ]; then
  echo "when the user is done reading the SMOKE result, archive and kill with:"
  echo "  bash $WT_SCRIPT archive $WT"
  echo "  tmux kill-session -t $TMUX_NAME"
  echo "note: archive moves the worktree to $WORKTREE_ROOT/_archive and locks it with branch $SLUG still checked out there, so 'git -C $CLONE branch -D $SLUG' is not safe to run right after archive; the branch stays until the archived worktree is removed or revived."
fi
